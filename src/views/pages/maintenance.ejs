<div id="alert-top" class="alert d-none"></div>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
  <h5 class="fw-bold mb-0"><i class="bi bi-tools me-2"></i>Log Maintenance Inventaris</h5>
  <button class="btn btn-primary btn-sm" onclick="openModalTambah()">
    <i class="bi bi-plus-lg me-1"></i> Tambah Log Maintenance
  </button>
</div>

<!-- Card Tabel -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 gap-2 flex-wrap">
    <div class="d-flex gap-2 flex-wrap">
      <div class="input-group" style="max-width:240px">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" class="form-control bg-light border-start-0" id="search-maint"
               placeholder="Cari nama barang..." oninput="filterLogs()"/>
      </div>
      <select class="form-select form-select-sm" id="filter-type" style="max-width:160px" onchange="filterLogs()">
        <option value="">Semua Tipe</option>
        <option value="preventif">Preventif</option>
        <option value="korektif">Korektif</option>
      </select>
      <input type="month" class="form-control form-control-sm" id="filter-month"
             style="max-width:160px" onchange="filterLogs()"/>
    </div>
    <span class="text-muted small" id="maint-count"></span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="text-muted small fw-semibold ps-3">#</th>
            <th class="text-muted small fw-semibold">Nama Barang</th>
            <th class="text-muted small fw-semibold">Tipe</th>
            <th class="text-muted small fw-semibold">Deskripsi</th>
            <th class="text-muted small fw-semibold">Kondisi</th>
            <th class="text-muted small fw-semibold">BHP Digunakan</th>
            <th class="text-muted small fw-semibold">Oleh</th>
            <th class="text-muted small fw-semibold">Tanggal</th>
          </tr>
        </thead>
        <tbody id="maint-table-body">
          <tr><td colspan="8" class="text-center text-muted py-4">Memuat data...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ── Modal Tambah Log Maintenance ── -->
<div class="modal fade" id="modalTambahMaint" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i>Tambah Log Maintenance</h6>
        <button type="button" class="btn-close" onclick="closeModalTambah()"></button>
      </div>
      <div class="modal-body">
        <div id="maint-modal-alert" class="alert d-none"></div>

        <div class="mb-3">
          <label class="form-label small fw-medium">Pilih Inventaris</label>
          <select class="form-select" id="f-maint-inventory">
            <option value="">-- Pilih Inventaris --</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-medium">Tipe Maintenance</label>
          <select class="form-select" id="f-maint-type">
            <option value="">-- Pilih Tipe --</option>
            <option value="preventif">Preventif (Pencegahan)</option>
            <option value="korektif">Korektif (Perbaikan)</option>
          </select>
        </div>
        <div class="row mb-3">
          <div class="col-md-6">
            <label class="form-label small fw-medium">Kondisi Sebelum</label>
            <select class="form-select" id="f-maint-cond-before">
              <option value="">-- Pilih --</option>
              <option value="baik">Baik</option>
              <option value="rusak_ringan">Rusak Ringan</option>
              <option value="rusak_berat">Rusak Berat</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-medium">Kondisi Sesudah</label>
            <select class="form-select" id="f-maint-cond-after">
              <option value="">-- Pilih --</option>
              <option value="baik">Baik</option>
              <option value="rusak_ringan">Rusak Ringan</option>
              <option value="rusak_berat">Rusak Berat</option>
            </select>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-medium">Deskripsi</label>
          <textarea class="form-control" id="f-maint-desc" rows="3"
                    placeholder="Jelaskan aktivitas maintenance..."></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-medium">Tanggal Maintenance</label>
          <input type="datetime-local" class="form-control" id="f-maint-date"/>
        </div>

        <!-- BHP -->
        <div class="mb-1">
          <label class="form-label small fw-medium">BHP yang Digunakan <span class="text-muted">(opsional)</span></label>
          <div id="f-bhp-used-list" class="border rounded p-2 mb-2" style="min-height:42px">
            <small class="text-muted">Belum ada BHP dipilih</small>
          </div>
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openModalPilihBhp()">
            <i class="bi bi-plus-lg me-1"></i>Tambah BHP
          </button>
        </div>
      </div>
      <div class="modal-footer border-top">
        <button class="btn btn-light btn-sm" onclick="closeModalTambah()">Batal</button>
        <button class="btn btn-primary btn-sm px-4" onclick="saveMaintenance()">Simpan</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Modal Pilih BHP ── -->
<div class="modal fade" id="modalPilihBhp" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold">Pilih BHP</h6>
        <button type="button" class="btn-close" onclick="closeModalPilihBhp()"></button>
      </div>
      <div class="modal-body p-0">
        <div id="bhp-pick-list" style="max-height:400px; overflow-y:auto">
          <div class="text-center text-muted py-4">Memuat...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const token   = localStorage.getItem('token');
  const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };

  let allLogs      = [];
  let selectedBhp  = [];
  let bsModalTambah, bsModalPilihBhp;

  const tipeBadge = {
    preventif: '<span class="badge bg-info-subtle text-info">Preventif</span>',
    korektif:  '<span class="badge bg-danger-subtle text-danger">Korektif</span>',
  };

  const kondisiBadge = {
    baik:         '<span class="badge bg-success">Baik</span>',
    rusak_ringan: '<span class="badge bg-warning text-dark">Rusak Ringan</span>',
    rusak_berat:  '<span class="badge bg-danger">Rusak Berat</span>',
  };

  document.addEventListener('DOMContentLoaded', () => {
    bsModalTambah   = new bootstrap.Modal(document.getElementById('modalTambahMaint'), { backdrop: 'static' });
    bsModalPilihBhp = new bootstrap.Modal(document.getElementById('modalPilihBhp'));

    // Set datetime default
    const now = new Date();
    document.getElementById('f-maint-date').value = now.toISOString().slice(0, 16);

    loadLogs();
    loadInventoriesDropdown();
  });

  // ── Load logs ────────────────────────────────────────────────
  async function loadLogs() {
    try {
      const res  = await fetch('/api/lab/maintenance-logs', { headers });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message);
      allLogs = data.data || [];
      filterLogs();
    } catch (err) {
      showAlert('alert-top', 'Gagal memuat log: ' + err.message, 'danger');
    }
  }

  function filterLogs() {
    const q     = document.getElementById('search-maint').value.toLowerCase();
    const type  = document.getElementById('filter-type').value;
    const month = document.getElementById('filter-month').value;

    let filtered = allLogs.filter(l => {
      const matchSearch = l.item_name.toLowerCase().includes(q);
      const matchType   = !type  || l.maintenance_type === type;
      const matchMonth  = !month || new Date(l.maintenance_date).toISOString().slice(0, 7) === month;
      return matchSearch && matchType && matchMonth;
    });

    renderLogs(filtered);
  }

  function renderLogs(logs) {
    const tbody = document.getElementById('maint-table-body');
    document.getElementById('maint-count').textContent = logs.length + ' log';

    if (!logs.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Tidak ada log maintenance</td></tr>';
      return;
    }

    tbody.innerHTML = logs.map((log, i) => {
      const bhpHtml = log.used_bhp?.length
        ? log.used_bhp.map(b => `<small class="d-block">• ${b.item_name}: ${b.quantity_used} ${b.bhp_id?.unit || 'pcs'}</small>`).join('')
        : '<span class="text-muted small">-</span>';

      const tgl = new Date(log.maintenance_date).toLocaleDateString('id-ID', {
        day: 'numeric', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      });

      return `
        <tr>
          <td class="ps-3 text-muted small">${i + 1}</td>
          <td class="fw-medium">${log.item_name}</td>
          <td>${tipeBadge[log.maintenance_type] || '-'}</td>
          <td class="small" style="max-width:200px">${log.description}</td>
          <td>
            ${kondisiBadge[log.condition_before] || '-'}
            <i class="bi bi-arrow-right text-muted small mx-1"></i>
            ${kondisiBadge[log.condition_after] || '-'}
          </td>
          <td>${bhpHtml}</td>
          <td class="small text-muted">${log.performed_by?.name || '-'}</td>
          <td class="small text-muted">${tgl}</td>
        </tr>`;
    }).join('');
  }

  // ── Load inventaris dropdown ─────────────────────────────────
  async function loadInventoriesDropdown() {
    try {
      const res  = await fetch('/api/lab/inventories-maintenance', { headers });
      const data = await res.json();
      const sel  = document.getElementById('f-maint-inventory');
      (data.data || []).forEach(inv => {
        const opt       = document.createElement('option');
        opt.value       = inv._id;
        opt.textContent = `${inv.item_name} (${inv.label_number || 'Tanpa Label'})`;
        sel.appendChild(opt);
      });
    } catch (err) {}
  }

  // ── Modal Tambah ─────────────────────────────────────────────
  function openModalTambah() {
    selectedBhp = [];
    renderBhpUsed();
    hideAlert('maint-modal-alert');
    bsModalTambah.show();
  }

  function closeModalTambah() { bsModalTambah.hide(); }

  async function saveMaintenance() {
    const inventory_id     = document.getElementById('f-maint-inventory').value;
    const maintenance_type = document.getElementById('f-maint-type').value;
    const condition_before = document.getElementById('f-maint-cond-before').value;
    const condition_after  = document.getElementById('f-maint-cond-after').value;
    const description      = document.getElementById('f-maint-desc').value.trim();
    const maintenance_date = document.getElementById('f-maint-date').value;

    if (!inventory_id || !maintenance_type || !condition_before || !condition_after || !description || !maintenance_date)
      return showAlert('maint-modal-alert', 'Semua field wajib diisi.', 'danger');

    try {
      const res  = await fetch('/api/lab/maintenance-logs', {
        method: 'POST', headers,
        body: JSON.stringify({
          inventory_id, maintenance_type, description,
          condition_before, condition_after, maintenance_date,
          used_bhp: selectedBhp.map(b => ({ bhp_id: b.bhp_id, item_name: b.item_name, quantity_used: b.quantity_used }))
        })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message);
      closeModalTambah();
      showAlert('alert-top', data.message || 'Log maintenance berhasil disimpan.', 'success');
      loadLogs();
    } catch (err) {
      showAlert('maint-modal-alert', err.message, 'danger');
    }
  }

  // ── Modal Pilih BHP ──────────────────────────────────────────
  async function openModalPilihBhp() {
    try {
      const res  = await fetch('/api/lab/bhp-stocks', { headers });
      const data = await res.json();
      const list = data.data || [];
      document.getElementById('bhp-pick-list').innerHTML = list.length
        ? list.map(bhp => `
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
              <div>
                <div class="fw-medium small">${bhp.item_name}</div>
                <small class="text-muted">Stok: ${bhp.quantity} ${bhp.unit}</small>
              </div>
              <button class="btn btn-sm btn-outline-primary" onclick="pilihBhp('${bhp._id}', '${bhp.item_name}', '${bhp.unit}', ${bhp.quantity})">
                Pilih
              </button>
            </div>`).join('')
        : '<div class="text-center text-muted py-4">Tidak ada stok BHP</div>';
    } catch (err) {}
    bsModalPilihBhp.show();
  }

  function closeModalPilihBhp() { bsModalPilihBhp.hide(); }

  function pilihBhp(id, nama, unit, stok) {
    const qty = parseInt(prompt(`Jumlah ${unit} "${nama}" yang digunakan? (Stok: ${stok})`, '1'));
    if (!qty || qty < 1) return;
    if (qty > stok) return alert(`Stok tidak cukup. Stok tersedia: ${stok} ${unit}`);
    selectedBhp.push({ bhp_id: id, item_name: nama, unit, quantity_used: qty });
    renderBhpUsed();
    closeModalPilihBhp();
  }

  function renderBhpUsed() {
    const el = document.getElementById('f-bhp-used-list');
    el.innerHTML = selectedBhp.length
      ? selectedBhp.map((b, i) => `
          <div class="d-flex justify-content-between align-items-center bg-light rounded px-2 py-1 mb-1">
            <small>${b.item_name}: ${b.quantity_used} ${b.unit}</small>
            <button class="btn btn-sm p-0 text-danger" onclick="hapusBhp(${i})" style="line-height:1">
              <i class="bi bi-x-lg" style="font-size:0.7rem"></i>
            </button>
          </div>`).join('')
      : '<small class="text-muted">Belum ada BHP dipilih</small>';
  }

  function hapusBhp(i) {
    selectedBhp.splice(i, 1);
    renderBhpUsed();
  }

  // ── Helpers ──────────────────────────────────────────────────
  function showAlert(id, msg, type) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.className   = `alert alert-${type}`;
    if (type === 'success') setTimeout(() => el.className = 'alert d-none', 3000);
  }

  function hideAlert(id) {
    document.getElementById(id).className = 'alert d-none';
  }
</script>